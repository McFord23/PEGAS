      m_Calls: []
  m_text: "\u041F\u0440\u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438
    \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E IP-\u0430\u0434\u0440\u0435\u0441\u0441\u0430
    \u043C\u043E\u0436\u043D\u043E \u0432\u043E\u0437\u043C\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u044D\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u043E\u043C \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0435\u0442\u0438, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 Radmin
    VPN \u0438\u043B\u0438 Hamachi. \u0414\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B
    \u044D\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0430 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0435\u0442\u0438 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
    \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0411\u0440\u0430\u043D\u0434\u043C\u0430\u0443\u044D\u0440.\n\r\n1)
    \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u0441\u044C \u043A
    \u043E\u0434\u043D\u043E\u0439 \u0441\u0435\u0442\u0438\n2) \u0421\u043A\u043E\u043F\u0438\u0440\u0443\u0439\u0442\u0435
    IP \u0445\u043E\u0441\u0442\u0430 \u0438 \u0432\u0441\u0442\u0430\u0432\u044C\u0442\u0435
    \u0435\u0433\u043E \u043D\u0438\u0436\u0435\n3) \u0412\u0432\u0435\u0434\u0438\u0442\u0435
    \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u043F\u043E\u0440\u0442 \u0445\u043E\u0441\u0442\u0430\n(\u043F\u043E-\u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E
    7777)"
