    \u043E\u043D\u0438 \u0434\u043E\u043B\u0433\u043E \u0431\u043E\u0440\u044F\u0442\u0441\u044F
    \u043D\u0430\u0434 \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C \u0437\u0430\u0434\u0430\u0447\u0438.
    \u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B-\u0441\u0451\u0441\u0442\u0440\u044B
    \u043E\u0442\u0447\u0430\u0439\u043D\u043E \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u043D\u0438
    \u043D\u0435 \u0445\u0443\u0436\u0435 \u0441\u0432\u043E\u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430."
